@using Query.Contract.UI.UserPanel.Order
@using Shared.Domain.Enums;
@model List<OrdersForUserPanelQueryService>
@{
    Layout = "_PanelLayout";
}

<div class="order-history-container">
    <!-- فیلترها -->
    <div class="order-filters">
        <div class="filter-tabs">
            <button class="filter-tab active" data-tab="paid">پرداخت شده</button>
            <button class="filter-tab" data-tab="pending">در انتظار</button>
            <button class="filter-tab" data-tab="delivered">تحویل‌شده</button>
            <button class="filter-tab" data-tab="cancelled">لغو‌شده</button>
        </div>
    </div>

    <!-- لیست سفارش‌ها -->
    <div class="order-list">
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                var statusClass = "";
                var statusText = "";

                switch (order.status)
                {
                    case OrderStatus.پرداخت_شده:
                        statusClass = "status-paid";
                        statusText = "پرداخت شده";
                        break;
                    case OrderStatus.پرداخت_نشده:
                        statusClass = "status-pending";
                        statusText = "در انتظار";
                        break;
                    case OrderStatus.ارسال_شده:
                        statusClass = "status-delivered";
                        statusText = "تحویل‌شده";
                        break;
                    case OrderStatus.لغو_شده_توسط_مشتری:
                        statusClass = "status-cancelled";
                        statusText = "لغو‌شده";
                        break;
                    default:
                        statusClass = "status-pending";
                        statusText = "در انتظار";
                        break;
                }

                <div class="order-item" data-status="@order.status.ToString()">
                    <div class="order-number">
                        <span class="order-label">شماره سفارش:</span>
                        <span class="order-value">@order.orderId</span>
                    </div>
                    <div class="order-date">
                        <span class="order-label">تاریخ:</span>
                        <span class="order-value">@order.OrderDate</span>
                    </div>
                    <div class="order-amount">
                        <span class="order-label">مبلغ:</span>
                        <span class="order-value">@String.Format("{0:N0}", order.paymentPrice) تومان</span>
                    </div>
                    <div class="order-status">
                        <span class="status-badge @statusClass">@statusText</span>
                    </div>
                    <a href="/Profile/OrderDetails?orderId=@order.orderId" class="order-detail-btn">جزئیات</a>
                </div>
            }
        }
        else
        {
            <div class="order-empty">
                <i class="fas fa-inbox"></i>
                <p>هیچ سفارشی یافت نشد.</p>
            </div>
        }
    </div>
</div>

