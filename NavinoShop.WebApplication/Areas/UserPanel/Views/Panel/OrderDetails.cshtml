@using Query.Contract.UI.UserPanel.Order
@using Shared.Application
@using Shared.Domain.Enums;
@model OrderUserPanelViewModel

<div id="oup-order-detail-page" class="oup-order-detail-page">
    <!-- =====================================================
         Page Header
         ====================================================== -->
    <div class="oup-page-header">

        <div class="oup-header-content">

            <div class="oup-header-icon">
                🧾
            </div>


            <div class="oup-header-info">

                <h1>
                    جزئیات سفارش
                </h1>

                <p>
                    مشاهده محصولات، فروشندگان، آدرس و اطلاعات پرداخت سفارش
                </p>

            </div>


            <div class="oup-order-number">

                <span>
                    شماره سفارش
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>

        </div>

    </div>



    <!-- =====================================================
         Payment Status
         ====================================================== -->
    <!-- Order Status -->

    <div id="oup-seller-status-panel"
         class="oup-seller-status-panel">

        <div class="oup-seller-status-header">

            <div class="oup-seller-status-header-content">

                <div class="oup-seller-status-icon">
                    📦
                </div>

                <div class="oup-seller-status-title">

                    <h2>
                        وضعیت سفارش
                    </h2>

                    <span>
                        وضعیت فعلی سفارش را انتخاب کنید
                    </span>

                </div>

            </div>

        </div>

        
   
 

        <div id="oup-seller-status-panel"
             class="oup-seller-status-panel">

            <div class="oup-seller-status-content">

                <div class="oup-seller-status-main">

                    <div class="oup-seller-status-icon">

                        @switch (Model.Status)
                        {
                            case OrderStatus.لغو_شده_توسط_مشتری:
                            case OrderStatus.لغو_شده_توسط_ادمین:
                            case OrderStatus.پرداخت_نشده:

                                <i class="fa-solid fa-xmark oup-status-danger"></i>

                                break;

                            case OrderStatus.پرداخت_شده:
                            case OrderStatus.ارسال_شده:

                                <i class="fa-solid fa-check oup-status-success"></i>

                                break;

                            default:

                                <i class="fa-solid fa-circle-info oup-status-default"></i>

                                break;
                        }

                    </div>


                    <div class="oup-seller-status-info">

                        @switch (Model.Status)
                        {
                            case OrderStatus.لغو_شده_توسط_مشتری:

                                <strong class="oup-status-danger">
                                    سفارش توسط شما لغو شده است.
                                </strong>

                                break;

                            case OrderStatus.لغو_شده_توسط_ادمین:

                                <strong class="oup-status-danger">
                                    سفارش توسط ادمین لغو شده است.
                                </strong>

                                break;

                            case OrderStatus.پرداخت_نشده:

                                <strong class="oup-status-danger">
                                    سفارش در انتظار پرداخت می‌باشد.
                                </strong>

                                break;

                            case OrderStatus.پرداخت_شده:

                                <strong class="oup-status-success">
                                    سفارش پرداخت شده و در حال آماده‌سازی برای ارسال است.
                                </strong>

                                break;

                            case OrderStatus.ارسال_شده:

                                <strong class="oup-status-success">
                                    سفارش برای شما ارسال شده است.
                                </strong>

                                break;

                            default:

                                <strong class="oup-status-default">
                                    وضعیت سفارش مشخص نیست.
                                </strong>

                                break;
                        }

                    </div>


                    @if (Model.Status == OrderStatus.پرداخت_نشده ||
                         Model.Status == OrderStatus.پرداخت_شده)
                    {
                        <div class="oup-seller-status-action">

                            <a href="javascript:void(0);"
                               class="oup-cancel-order-button"
                               data-order-id="@Model.OrderId">

                                <i class="fa-solid fa-ban"></i>

                                <span>لغو سفارش</span>

                            </a>

                        </div>
                    }
                    @if (Model.Status == OrderStatus.پرداخت_نشده)
                    {
                        <div class="oup-seller-status-action">

                            <a href="/Checkout"
                               class="oup-cancel-order oup-payment-button">

                                <i class="fa-solid fa-credit-card"></i>

                                <span>پرداخت</span>

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

        

    </div>



    <!-- =====================================================
         Main Grid
         ====================================================== -->

    <div class="oup-main-grid">


        <!-- =================================================
             Main Column
             ================================================== -->

        <div class="oup-main-column">


            <!-- =================================================
                 Order Summary
                 ================================================== -->

            <section class="oup-section-card">


                <div class="oup-section-header">

                    <div class="oup-section-title">

                        <span class="oup-title-icon">
                            🛒
                        </span>

                        <div>

                            <h2>
                                خلاصه سفارش
                            </h2>

                            <span>
                                اطلاعات کلی سفارش شما
                            </span>

                        </div>

                    </div>

                </div>


                <div class="oup-summary-grid">


                    <!-- Price -->

                    <div class="oup-summary-item">

                        <span>
                            مبلغ کالاها
                        </span>

                        <strong>
                            @Model.Price.ToString("N0") تومان
                        </strong>

                    </div>


                    <!-- Discount -->

                    <div class="oup-summary-item">

                        <span>
                            تخفیف
                        </span>

                        <strong class="oup-discount-text">

                            @Model.DiscountPrice.ToString("N0") تومان

                        </strong>

                    </div>


                    <!-- Post -->

                    <div class="oup-summary-item">

                        <span>
                            هزینه ارسال
                        </span>

                        <strong>
                            @Model.PostPrice.ToString("N0") تومان
                        </strong>

                    </div>


                    <!-- Payment -->

                    <div class="oup-summary-item oup-summary-total">

                        <span>
                            مبلغ قابل پرداخت
                        </span>

                        <strong>
                            @Model.PaymentPrice.ToString("N0") تومان
                        </strong>

                    </div>


                </div>

            </section>



            <!-- =================================================
                 Sellers
                 ================================================== -->

            <section class="oup-section-card">


                <!-- Sellers Header -->

                <div class="oup-section-header">

                    <div class="oup-section-title">

                        <span class="oup-title-icon">
                            🏪
                        </span>

                        <div>

                            <h2>
                                فروشندگان سفارش
                            </h2>

                            <span>
                                محصولات خریداری شده به تفکیک فروشنده
                            </span>

                        </div>

                    </div>


                    <span class="oup-count-badge">

                        @Model.OrderSellers.Count
                        فروشنده

                    </span>

                </div>



                <!-- =================================================
                     Sellers Loop
                     ================================================== -->
                @if (Model.OrderSellers != null && Model.OrderSellers.Any())
                {

                    foreach (var seller in Model.OrderSellers)
                    {

                        <div class="oup-seller-card">

                            @if (seller.status == OrderSellerStatus.لغو_شده_توسط_فروشنده)
                            {
                                <div class="oup-seller-status-cancelled">
                                    <i class="fa-solid fa-ban"></i>
                                    <span>
                                        لغو شده توسط فروشنده
                                    </span>
                                </div>
                            }
                            else if (seller.status == OrderSellerStatus.لغو_شده_توسط_ادمین)
                            {
                                <div class="oup-seller-status-cancelled">
                                    <i class="fa-solid fa-ban"></i>
                                    <span>
                                        لغو شده توسط ادمین
                                    </span>
                                </div>
                            }
                            <!-- =========================================
                                 Seller Header
                                 ========================================== -->
                            <div class="oup-seller-header">

                                <div class="oup-seller-info">

                                    <div class="oup-seller-avatar">
                                        <img src="@FileDirectories.SellerImageDirectory100@seller.ImageName"
                                             alt="@seller.SellerName"
                                             asp-append-version="true" />
                                    </div>

                                    <div>

                                        <h3>
                                            @seller.SellerName
                                        </h3>

                                        <div class="oup-seller-meta">

                                            <span>
                                                🏪 شناسه فروشنده:
                                                @seller.SellerId
                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(seller.PostTitle))
                                            {
                                                <span>
                                                    🚚 @seller.PostTitle
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>


                              


                                <div class="oup-seller-price">

                                    <span>
                                        مبلغ فروشنده
                                    </span>

                                    <strong>
                                        @seller.Price.ToString("N0") تومان
                                    </strong>

                                </div>

                            </div>



                            <!-- =========================================
                                 Seller Discount
                                 ========================================== -->
                            @if (seller.DiscountId > 0 ||
                                                             seller.DiscountPercent > 0 ||
                                                             !string.IsNullOrWhiteSpace(seller.DiscountTitle))
                            {

                                <div class="oup-seller-discount">


                                    <div class="oup-discount-icon">
                                        %
                                    </div>


                                    <div class="oup-discount-info">

                                        <strong>

                                            @if (!string.IsNullOrWhiteSpace(seller.DiscountTitle))
                                            {
                                                @seller.DiscountTitle
                                            }
                                            else
                                            {
                                                <text>
                                                    تخفیف فروشنده
                                                </text>
                                            }

                                        </strong>


                                        @if (seller.DiscountId > 0)
                                        {
                                            <span>
                                                شناسه تخفیف:
                                                @seller.DiscountId
                                            </span>
                                        }

                                    </div>


                                    <div class="oup-discount-value">

                                        @seller.DiscountPercent٪

                                    </div>


                                </div>

                            }



                            <!-- =========================================
                                 Products
                                 ========================================== -->

                            <div class="oup-products-list">


                                @if (seller.Items != null && seller.Items.Any())
                                {

                                    foreach (var item in seller.Items)
                                    {

                                        <div class="oup-product-item">


                                            <!-- Product Image -->

                                            <div class="oup-product-image">

                                                @if (!string.IsNullOrWhiteSpace(item.ImageName))
                                                {

                                                    <img src="@FileDirectories.ProductImageDirectory100@item.ImageName"
                                                         alt="@item.ImageAlt"
                                                         asp-append-version="true" />

                                                }
                                                else
                                                {

                                                    <img src="https://placehold.co/160x160/f7f7f7/777?text=Product"
                                                         alt="@item.ProductName" />

                                                }

                                            </div>



                                            <!-- Product Info -->

                                            <div class="oup-product-info">


                                                <h4>
                                                    @item.ProductName
                                                </h4>


                                                <div class="oup-product-details">

                                                    <span>
                                                        کد محصول:
                                                        @item.ProductId
                                                    </span>


                                                    <span>
                                                        کد فروش:
                                                        @item.ProductSellId
                                                    </span>

                                                </div>


                                                <div class="oup-product-quantity">

                                                    تعداد:

                                                    <strong>
                                                        @item.Quantity
                                                    </strong>

                                                    عدد

                                                </div>


                                            </div>



                                            <!-- Product Price -->

                                            <div class="oup-product-price">


                                                @if (item.PriceAfterOff < item.Price)
                                                {

                                                    <span class="oup-old-price">

                                                        @item.Price.ToString("N0")
                                                        تومان

                                                    </span>

                                                }


                                                <strong>

                                                    @item.PriceAfterOff.ToString("N0")
                                                    تومان

                                                </strong>


                                            </div>


                                        </div>

                                    }

                                }
                                else
                                {

                                    <div style="
                                        padding: 25px;
                                        text-align: center;
                                        color: #888;
                                        font-size: 12px;
                                        ">
                                        محصولی برای این فروشنده ثبت نشده است.
                                    </div>

                                }

                            </div>



                            <!-- =========================================
                                 Seller Footer
                                 ========================================== -->

                            <div class="oup-seller-footer">


                                <!-- Post -->

                                <div>

                                    <span>
                                        هزینه ارسال
                                    </span>

                                    <strong>
                                        @seller.PostPrice.ToString("N0")
                                        تومان
                                    </strong>

                                </div>


                                <!-- Discount -->

                                <div>

                                    <span>
                                        تخفیف
                                    </span>

                                    <strong class="oup-discount-text">

                                        @seller.DiscountPrice.ToString("N0")
                                        تومان

                                    </strong>

                                </div>


                                <!-- Payment -->

                                <div class="oup-seller-total">

                                    <span>
                                        مبلغ پرداختی
                                    </span>

                                    <strong>

                                        @seller.PaymentPrice.ToString("N0")
                                        تومان

                                    </strong>

                                </div>


                            </div>


                        </div>

                    }

                }
                else
                {

                    <div style="
                        padding: 35px;
                        text-align: center;
                        color: #888;
                        font-size: 13px;
                        ">
                        هیچ فروشنده‌ای برای این سفارش ثبت نشده است.
                    </div>

                }


            </section>


        </div>



        <!-- =================================================
             Sidebar
             ================================================== -->

        <aside class="oup-sidebar">


            <!-- =================================================
                 Address
                 ================================================== -->
            @if (Model.Address != null)
            {

                <section class="oup-sidebar-card">


                    <div class="oup-sidebar-title">

                        <span class="oup-sidebar-icon">
                            📍
                        </span>

                        <div>

                            <h2>
                                آدرس ارسال
                            </h2>

                            <span>
                                آدرس تحویل سفارش
                            </span>

                        </div>

                    </div>



                    <div class="oup-address-content">


                        <!-- Full Name -->

                        <div class="oup-address-row">

                            <span>
                                تحویل گیرنده
                            </span>

                            <strong>
                                @Model.Address.FullName
                            </strong>

                        </div>


                        <!-- State / City -->

                        <div class="oup-address-row">

                            <span>
                                استان / شهر
                            </span>

                            <strong>
                                @Model.Address.StateName،
                                @Model.Address.CityName
                            </strong>

                        </div>


                        <!-- Address -->

                        <div class="oup-address-detail">

                            <span>
                                آدرس
                            </span>

                            <p>
                                @Model.Address.AddressDetail
                            </p>

                        </div>


                        <!-- Postal Code -->

                        <div class="oup-address-row">

                            <span>
                                کد پستی
                            </span>

                            <strong>
                                @Model.Address.PostalCode
                            </strong>

                        </div>


                        <!-- Phone -->

                        <div class="oup-address-row">

                            <span>
                                شماره تماس
                            </span>

                            <strong>
                                @Model.Address.Phone
                            </strong>

                        </div>


                        <!-- National Code -->
                        @if (!string.IsNullOrWhiteSpace(Model.Address.NationalCode))
                        {

                            <div class="oup-address-row">

                                <span>
                                    کد ملی
                                </span>

                                <strong>
                                    @Model.Address.NationalCode
                                </strong>

                            </div>

                        }


                    </div>


                </section>

            }



            <!-- =================================================
                 Order Discount
                 ================================================== -->
            @if (Model.DiscountId > 0 ||
                             Model.DiscountPercent > 0 ||
                             !string.IsNullOrWhiteSpace(Model.DiscountTitle))
            {

                <section class="oup-sidebar-card">


                    <div class="oup-sidebar-title">

                        <span class="oup-sidebar-icon">
                            %
                        </span>

                        <div>

                            <h2>
                                تخفیف سفارش
                            </h2>

                            <span>
                                تخفیف اعمال شده
                            </span>

                        </div>

                    </div>



                    <div class="oup-order-discount">


                        <!-- Discount Title -->

                        <div>

                            <span>
                                عنوان تخفیف
                            </span>

                            <strong>

                                @if (!string.IsNullOrWhiteSpace(Model.DiscountTitle))
                                {
                                    @Model.DiscountTitle
                                }
                                else
                                {
                                    <text>
                                        تخفیف سفارش
                                    </text>
                                }

                            </strong>

                        </div>


                        <!-- Discount Percent -->

                        <div>

                            <span>
                                درصد تخفیف
                            </span>

                            <strong>
                                @Model.DiscountPercent٪
                            </strong>

                        </div>


                        <!-- Discount Price -->

                        <div class="oup-discount-final">

                            <span>
                                مبلغ تخفیف
                            </span>

                            <strong>
                                @Model.DiscountPrice.ToString("N0")
                                تومان
                            </strong>

                        </div>


                    </div>


                </section>

            }



            <!-- =================================================
                 Payment Information
                 ================================================== -->

            <section class="oup-sidebar-card">


                <div class="oup-sidebar-title">

                    <span class="oup-sidebar-icon">
                        💳
                    </span>

                    <div>

                        <h2>
                            اطلاعات پرداخت
                        </h2>

                        <span>
                            جزئیات پرداخت سفارش
                        </span>

                    </div>

                </div>



                <div class="oup-payment-info">


                    <!-- Product Price -->

                    <div class="oup-payment-row">

                        <span>
                            مبلغ کالاها
                        </span>

                        <strong>
                            @Model.Price.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Price After Discount -->

                    <div class="oup-payment-row">

                        <span>
                            مبلغ پس از تخفیف
                        </span>

                        <strong>
                            @Model.PriceAfterOff.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Discount -->

                    <div class="oup-payment-row">

                        <span>
                            تخفیف
                        </span>

                        <strong class="oup-discount-text">

                            -
                            @Model.DiscountPrice.ToString("N0")
                            تومان

                        </strong>

                    </div>


                    <!-- Post -->

                    <div class="oup-payment-row">

                        <span>
                            هزینه ارسال
                        </span>

                        <strong>
                            @Model.PostPrice.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <div class="oup-payment-divider"></div>


                    <!-- Payment -->

                    <div class="oup-payment-total">

                        <span>
                            مبلغ نهایی
                        </span>

                        <strong>

                            @Model.PaymentPrice.ToString("N0")
                            تومان

                        </strong>

                    </div>


                </div>


            </section>


        </aside>


    </div>


</div>
<script>
    $(document).on('click', '.oup-cancel-order-button', function () {

        const orderId = $(this).data('order-id');

        AjaxSweetRefresh(
            "لغو سفارش",
            "آیا از لغو این سفارش مطمئن هستید؟",
            "warning",
            "بله، لغو شود",
            "انصراف",
            ` /Profile/Order/CancellOrderByUser?orderId=${orderId}`
        );

    });
</script>