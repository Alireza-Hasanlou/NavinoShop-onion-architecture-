
<div class="transaction-modal-card" id="transactionModalCard">
    <form asp-controller="Wallet" asp-action="ChargeWallet" method="post">
        <div class="transaction-modal-title">
            شارژ کیف پول

        </div>

        <!-- فرم (بدون تگ form برای کنترل دستی با ajax) -->
        <!-- مبلغ -->
        <div class="transaction-modal-group">
            <label for="transactionAmountInput">💰 مبلغ (تومان)</label>
            <input name="amount" type="number" id="transactionAmountInput" placeholder="مثلاً ۱,۲۵۰,۰۰۰" step="1000" min="0">
        </div>

        <!-- درگاه (Enum) -->
        <div class="transaction-modal-group">
            <label for="transactionPortalSelect">🏦 درگاه تراکنش</label>
            <select name="portal" id="transactionPortalSelect">
                <option value="زرین_پال">زرین‌پال</option>
                <option value="به_پرداخت_ملت">به‌پرداخت ملت</option>
                <option value="سامان">سامان</option>
                <option value="دستی_ادمین">دستی ادمین</option>
            </select>
        </div>

        <!-- توضیحات -->
        <div class="transaction-modal-group">
            <label for="transactionDescriptionInput">📝 توضیحات</label>
            <textarea name="description" id="transactionDescriptionInput" placeholder="توضیح دلخواه ..."></textarea>
        </div>

        <!-- دکمه‌ها -->
        <div class="transaction-modal-actions">
            <button class="transaction-modal-btn transaction-modal-btn-secondary" onclick="close_Modal_Ajax()">انصراف</button>
            <button type="submit" class="transaction-modal-btn transaction-modal-btn-primary" id="submitTransactionBtn">✔ ثبت و ارسال</button>
        </div>

    </form>
</div>




