@using Query.Contract.UI.UserPanel.Seller
@using Shared.Application
@using Shared.Domain.Enums
@model OrderUserPanelViewModel

<div id="oup-order-detail-page" class="oup-order-detail-page">

    <!-- =====================================================
         Invoice Header
         ====================================================== -->

    <div class="oup-page-header">

        <div class="oup-header-content">

            <div class="oup-header-icon">
                🧾
            </div>

            <div class="oup-header-info">

                <h1>
                    فاکتور فروش
                </h1>

                <p>
                    جزئیات محصولات و اطلاعات مالی سفارش
                </p>

            </div>

            <div class="oup-order-number">

                <span>
                    شماره فاکتور
                </span>

                <strong>
                    #@Model.OrderId
                </strong>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Payment Status
         ====================================================== -->
    <!-- =====================================================
     Payment / Seller Order Status
     ====================================================== -->
    <!-- Order Status -->

    <div id="oup-seller-status-panel"
         class="oup-seller-status-panel">

        <div class="oup-seller-status-header">

            <div class="oup-seller-status-header-content">

                <div class="oup-seller-status-icon">
                    📦
                </div>

                <div class="oup-seller-status-title">

                    <h2>
                        وضعیت سفارش
                    </h2>

                    <span>
                        وضعیت فعلی سفارش را انتخاب کنید
                    </span>

                </div>

            </div>

        </div>

        
   
        @{
            bool isOrderCancelled =
                Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_مشتری ||
                Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_فروشنده ||
                Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_ادمین;
        }

        <div id="oup-seller-status-panel"
             class="oup-seller-status-panel">

            @if (isOrderCancelled)
            {
                <!-- =================================================
             Cancelled Order
             ================================================== -->

                <div class="oup-seller-status-cancelled">

                    <div class="oup-seller-status-cancelled-icon">
                        <i class="fa-solid fa-ban"></i>
                    </div>

                    <div class="oup-seller-status-cancelled-content">

                        <strong>
                            @if (Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_مشتری)
                            {
                                @:لغو شده توسط مشتری
                            }
                            else if (Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_فروشنده)
                            {
                                @:لغو شده توسط فروشنده
                            }
                            else if (Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_ادمین)
                            {
                                @:لغو شده توسط ادمین
                            }
                        </strong>

                        <span>
                            وضعیت این سفارش لغو شده است و امکان تغییر وضعیت آن وجود ندارد.
                        </span>

                    </div>

                </div>
            }
            else
            {
                <!-- =================================================
             Seller Order Status Header
             ================================================== -->

                <div class="oup-seller-status-header">

                    <div class="oup-seller-status-header-content">

                        <div class="oup-seller-status-icon">
                            <i class="fa-solid fa-box"></i>
                        </div>

                        <div class="oup-seller-status-title">

                            <h2>
                                وضعیت سفارش
                            </h2>

                            <span>
                                وضعیت فعلی سفارش را مشاهده و در صورت نیاز تغییر دهید
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
             Seller Order Status Buttons
             ================================================== -->

                <div id="oup-seller-status-buttons"
                     class="oup-seller-status-buttons">

                    <input type="hidden"
                           value="@Model.SellerId"
                           id="oup-seller-status-seller-id" />


                    <!-- =================================================
                 پرداخت شده
                 ================================================== -->

                    <button type="button"
                            class="oup-seller-status-button
                        oup-seller-status-button-success
                        @(Model.OrderSellerStatus == OrderSellerStatus.پرداخت_شده
                            ? "oup-seller-status-button-active"
                            : "oup-seller-status-button-inactive")"
                            data-order-id="@Model.OrderId"
                            data-seller-id="@Model.SellerId"
                            data-status="@((int)OrderSellerStatus.پرداخت_شده)"
                            data-status-title="پرداخت شده">

                        <span class="oup-seller-status-button-icon">
                            <i class="fa-solid fa-dollar-sign"></i>
                        </span>

                        <span>
                            پرداخت شده
                        </span>

                    </button>


                    <!-- =================================================
                 پرداخت نشده
                 ================================================== -->

                    <button type="button"
                            class="oup-seller-status-button
                        @(Model.OrderSellerStatus == OrderSellerStatus.پرداخت_نشده
                            ? "oup-seller-status-button-active"
                            : "oup-seller-status-button-inactive")"
                            data-order-id="@Model.OrderId"
                            data-seller-id="@Model.SellerId"
                            data-status="@((int)OrderSellerStatus.پرداخت_نشده)"
                            data-status-title="پرداخت نشده">

                        <span class="oup-seller-status-button-icon">
                            <i class="fa-regular fa-credit-card"></i>
                        </span>

                        <span>
                            پرداخت نشده
                        </span>

                    </button>


                    <!-- =================================================
                 لغو شده توسط فروشنده
                 ================================================== -->

                    <button type="button"
                            class="oup-seller-status-button
                        @(Model.OrderSellerStatus == OrderSellerStatus.لغو_شده_توسط_فروشنده
                            ? "oup-seller-status-button-active"
                            : "oup-seller-status-button-inactive")"
                            data-order-id="@Model.OrderId"
                            data-seller-id="@Model.SellerId"
                            data-status="@((int)OrderSellerStatus.لغو_شده_توسط_فروشنده)"
                            data-status-title="لغو شده توسط فروشنده">

                        <span class="oup-seller-status-button-icon">
                            <i class="fa-solid fa-store-slash"></i>
                        </span>

                        <span>
                            لغو شده توسط فروشنده
                        </span>

                    </button>


                    <!-- =================================================
                 در حال آماده سازی
                 ================================================== -->

                    <button type="button"
                            class="oup-seller-status-button
                        @(Model.OrderSellerStatus == OrderSellerStatus.در_حال_آماده_سازی
                            ? "oup-seller-status-button-active"
                            : "oup-seller-status-button-inactive")"
                            data-order-id="@Model.OrderId"
                            data-seller-id="@Model.SellerId"
                            data-status="@((int)OrderSellerStatus.در_حال_آماده_سازی)"
                            data-status-title="در حال آماده سازی">

                        <span class="oup-seller-status-button-icon">
                            <i class="fa-solid fa-gears"></i>
                        </span>

                        <span>
                            در حال آماده سازی
                        </span>

                    </button>


                    <!-- =================================================
                 ارسال شده
                 ================================================== -->

                    <button type="button"
                            class="oup-seller-status-button
                        oup-seller-status-button-success
                        @(Model.OrderSellerStatus == OrderSellerStatus.ارسال_شده
                            ? "oup-seller-status-button-active"
                            : "oup-seller-status-button-inactive")"
                            data-order-id="@Model.OrderId"
                            data-seller-id="@Model.SellerId"
                            data-status="@((int)OrderSellerStatus.ارسال_شده)"
                            data-status-title="ارسال شده">

                        <span class="oup-seller-status-button-icon">
                            <i class="fa-solid fa-truck"></i>
                        </span>

                        <span>
                            ارسال شده
                        </span>

                    </button>

                </div>
            }

        </div>

        

    </div>

    

    <!-- =====================================================
         Main Grid
         ====================================================== -->

    <div class="oup-main-grid">


        <!-- =================================================
             Main Column
             ================================================== -->

        <div class="oup-main-column">


            <!-- =================================================
                 Invoice Summary
                 ================================================== -->

            <section class="oup-section-card">

                <div class="oup-section-header">

                    <div class="oup-section-title">

                        <span class="oup-title-icon">
                            💰
                        </span>

                        <div>

                            <h2>
                                خلاصه مالی فاکتور
                            </h2>

                            <span>
                                محاسبه مبلغ محصولات و تخفیف
                            </span>

                        </div>

                    </div>

                </div>


                <div class="oup-summary-grid">


                    <!-- Products Price -->

                    <div class="oup-summary-item">

                        <span>
                            مبلغ محصولات
                        </span>

                        <strong>
                            @Model.Price.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Discount -->

                    <div class="oup-summary-item">

                        <span>
                            تخفیف
                        </span>

                        <strong class="oup-discount-text">

                            @Model.DiscountPrice.ToString("N0")
                            تومان

                        </strong>

                    </div>


                    <!-- Post Price -->

                    <div class="oup-summary-item">

                        <span>
                            هزینه ارسال
                        </span>

                        <strong>
                            @Model.PostPrice.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Seller Payment -->

                    <div class="oup-summary-item oup-summary-total">

                        <span>
                            مبلغ قابل پرداخت به فروشنده
                        </span>

                        <strong>
                            @Model.PaymentPriceSeller.ToString("N0")
                            تومان
                        </strong>

                    </div>


                </div>

            </section>



            <!-- =================================================
                 Products
                 ================================================== -->

            <section class="oup-section-card">


                <div class="oup-section-header">

                    <div class="oup-section-title">

                        <span class="oup-title-icon">
                            🛍️
                        </span>

                        <div>

                            <h2>
                                محصولات فاکتور
                            </h2>

                            <span>
                                لیست محصولات این فاکتور
                            </span>

                        </div>

                    </div>


                    <span class="oup-count-badge">

                        @(Model.OrderItems?.Count ?? 0)
                        کالا

                    </span>

                </div>



                <!-- =================================================
                     Products List
                     ================================================== -->

                <div class="oup-products-list">

                    @if (Model.OrderItems != null && Model.OrderItems.Any())
                    {

                        foreach (var item in Model.OrderItems)
                        {

                            <div class="oup-product-item">


                                <!-- Product Image -->

                                <div class="oup-product-image">

                                    @if (!string.IsNullOrWhiteSpace(item.ImageName))
                                    {

                                        <img src="@FileDirectories.ProductImageDirectory100@item.ImageName"
                                             alt="@item.ImageAlt"
                                             asp-append-version="true" />

                                    }
                                    else
                                    {

                                        <img src="https://placehold.co/160x160/f7f7f7/777?text=Product"
                                             alt="@item.ProductName" />

                                    }

                                </div>



                                <!-- Product Information -->

                                <div class="oup-product-info">

                                    <h4>
                                        @item.ProductName
                                    </h4>


                                    <div class="oup-product-details">

                                        <span>
                                            کد محصول:
                                            @item.ProductId
                                        </span>

                                    </div>


                                    <div class="oup-product-quantity">

                                        تعداد:

                                        <strong>
                                            @item.Quantity
                                        </strong>

                                        عدد

                                    </div>

                                </div>



                                <!-- Product Price -->

                                <div class="oup-product-price">


                                    @if (item.PriceAfterOff < item.Price && item.PriceAfterOff > 0)
                                    {

                                        <span class="oup-old-price">

                                            @item.Price.ToString("N0")
                                            تومان

                                        </span>

                                    }


                                    <strong>
                                        @((Model.PriceAfterOff > 0) ? Model.PriceAfterOff.ToString("N0") : Model.Price.ToString("N0"))
                                        تومان

                                    </strong>


                                </div>


                            </div>

                        }

                    }
                    else
                    {

                        <div style="
                            padding: 35px;
                            text-align: center;
                            color: #888;
                            font-size: 13px;
                            ">

                            محصولی در این فاکتور ثبت نشده است.

                        </div>

                    }

                </div>


            </section>


        </div>



        <!-- =================================================
             Sidebar
             ================================================== -->

        <aside class="oup-sidebar">


            <!-- =================================================
                 Customer / Receiver Address
                 ================================================== -->
            @if (Model.Address != null)
            {

                <section class="oup-sidebar-card">


                    <div class="oup-sidebar-title">

                        <span class="oup-sidebar-icon">
                            📍
                        </span>

                        <div>

                            <h2>
                                اطلاعات خریدار
                            </h2>

                            <span>
                                اطلاعات گیرنده سفارش
                            </span>

                        </div>

                    </div>



                    <div class="oup-address-content">


                        <!-- Full Name -->

                        <div class="oup-address-row">

                            <span>
                                نام و نام خانوادگی
                            </span>

                            <strong>
                                @Model.Address.FullName
                            </strong>

                        </div>


                        <!-- State / City -->

                        <div class="oup-address-row">

                            <span>
                                استان / شهر
                            </span>

                            <strong>
                                @Model.Address.StateName،
                                @Model.Address.CityName
                            </strong>

                        </div>


                        <!-- Address -->

                        <div class="oup-address-detail">

                            <span>
                                آدرس
                            </span>

                            <p>
                                @Model.Address.AddressDetail
                            </p>

                        </div>


                        <!-- Postal Code -->

                        <div class="oup-address-row">

                            <span>
                                کد پستی
                            </span>

                            <strong>
                                @Model.Address.PostalCode
                            </strong>

                        </div>


                        <!-- Phone -->

                        <div class="oup-address-row">

                            <span>
                                شماره تماس
                            </span>

                            <strong>
                                @Model.Address.Phone
                            </strong>

                        </div>


                        <!-- National Code -->
                        @if (!string.IsNullOrWhiteSpace(Model.Address.NationalCode))
                        {

                            <div class="oup-address-row">

                                <span>
                                    کد ملی
                                </span>

                                <strong>
                                    @Model.Address.NationalCode
                                </strong>

                            </div>

                        }


                    </div>


                </section>

            }



            <!-- =================================================
                 Order Discount
                 ================================================== -->
            @if (Model.DiscountId > 0 ||
                             Model.DiscountPercent > 0 ||
                             !string.IsNullOrWhiteSpace(Model.DiscountTitle))
            {

                <section class="oup-sidebar-card">


                    <div class="oup-sidebar-title">

                        <span class="oup-sidebar-icon">
                            %
                        </span>

                        <div>

                            <h2>
                                تخفیف سفارش
                            </h2>

                            <span>
                                تخفیف اعمال شده روی سفارش
                            </span>

                        </div>

                    </div>



                    <div class="oup-order-discount">


                        <!-- Discount Title -->

                        <div>

                            <span>
                                عنوان تخفیف
                            </span>

                            <strong>

                                @if (!string.IsNullOrWhiteSpace(Model.DiscountTitle))
                                {
                                    @Model.DiscountTitle
                                }
                                else
                                {
                                    <text>
                                        تخفیف سفارش
                                    </text>
                                }

                            </strong>

                        </div>


                        <!-- Discount Percent -->

                        <div>

                            <span>
                                درصد تخفیف
                            </span>

                            <strong>
                                @Model.DiscountPercent٪
                            </strong>

                        </div>


                        <!-- Discount Amount -->

                        <div class="oup-discount-final">

                            <span>
                                مبلغ تخفیف
                            </span>

                            <strong>
                                @Model.DiscountPrice.ToString("N0")
                                تومان
                            </strong>

                        </div>


                    </div>


                </section>

            }



            <!-- =================================================
                 Payment Information
                 ================================================== -->

            <section class="oup-sidebar-card">


                <div class="oup-sidebar-title">

                    <span class="oup-sidebar-icon">
                        💳
                    </span>

                    <div>

                        <h2>
                            جمع فاکتور
                        </h2>

                        <span>
                            جزئیات محاسبه مبلغ
                        </span>

                    </div>

                </div>



                <div class="oup-payment-info">


                    <!-- Product Price -->

                    <div class="oup-payment-row">

                        <span>
                            مبلغ محصولات
                        </span>

                        <strong>
                            @Model.Price.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Price After Discount -->

                    <div class="oup-payment-row">

                        <span>
                            مبلغ پس از تخفیف
                        </span>

                        <strong>
                            @Model.PriceAfterOff.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <!-- Discount -->

                    <div class="oup-payment-row">

                        <span>
                            تخفیف
                        </span>

                        <strong class="oup-discount-text">

                            -
                            @Model.DiscountPrice.ToString("N0")
                            تومان

                        </strong>

                    </div>


                    <!-- Post -->

                    <div class="oup-payment-row">

                        <span>
                            هزینه ارسال
                        </span>

                        <strong>
                            @Model.PostPrice.ToString("N0")
                            تومان
                        </strong>

                    </div>


                    <div class="oup-payment-divider"></div>


                    <!-- Seller Payment -->

                    <div class="oup-payment-total">

                        <span>
                            سهم قابل پرداخت به فروشنده
                        </span>

                        <strong>

                            @Model.PaymentPriceSeller.ToString("N0")
                            تومان

                        </strong>

                    </div>


                </div>


            </section>


        </aside>


    </div>


</div>

<script>

    $(document).on(
        'click',
        '#oup-seller-status-buttons .oup-seller-status-button',
        function () {

            const button = $(this);

            const orderId = button.data('order-id');

            const sellerId =
                $('#oup-seller-status-seller-id').val();

            const status = button.data('status');

            const statusTitle =
                button.data('status-title');


            /*
             * اگر همین وضعیت در حال حاضر فعال است،
             * درخواست ارسال نشود.
             */

            if (
                button.hasClass(
                    'oup-seller-status-button-active'
                )
            ) {
                return;
            }


            /*
             * Confirmation
             */

            Swal.fire({

                title: 'تغییر وضعیت سفارش',

                text:
                    `آیا وضعیت سفارش به «${statusTitle}» تغییر کند؟`,

                icon: 'question',

                showCancelButton: true,

                confirmButtonText: 'بله، تغییر بده',

                cancelButtonText: 'انصراف',

                confirmButtonColor: '#fcb941',

                cancelButtonColor: '#777'

            }).then(function (result) {

                if (!result.isConfirmed) {
                    return;
                }


                /*
                 * همه دکمه‌ها
                 */

                const allButtons =
                    $('#oup-seller-status-buttons .oup-seller-status-button');


                /*
                 * Loading
                 */

                allButtons.addClass(
                    'oup-seller-status-button-loading'
                );


                /*
                 * AJAX
                 */

                $.ajax({

                    url: '/Profile/Order/ChangeOrderSellerStatus',

                    type: 'POST',

                    data: {

                        orderId: orderId,

                        status: status,

                        SellerId: sellerId,

                        __RequestVerificationToken:
                            $('input[name="__RequestVerificationToken"]')
                                .val()

                    },


                    /*
                     * Success
                     */

                    success: function (response) {

                        if (!response.success) {

                            allButtons.removeClass(
                                'oup-seller-status-button-loading'
                            );


                            Swal.fire({

                                title: 'خطا',

                                text:
                                    response.message ||
                                    'تغییر وضعیت سفارش انجام نشد.',

                                icon: 'error',

                                confirmButtonColor: '#fcb941'

                            });

                            return;
                        }


                        /*
                         * اگر وضعیت انتخاب شده یکی از وضعیت‌های
                         * لغو شده باشد، دیگر دکمه‌ها نباید نمایش داده شوند.
                         */

                        const isCancelledStatus =
                            status == @((int)OrderSellerStatus.لغو_شده_توسط_فروشنده)
                                ||
                            status == @((int)OrderSellerStatus.لغو_شده_توسط_ادمین)
                                ||
                            status == @((int)OrderSellerStatus.لغو_شده_توسط_مشتری);


                        if (isCancelledStatus) {

                            /*
                             * حذف پنل دکمه‌ها
                             */

                            $('#oup-seller-status-buttons').remove();


                            /*
                             * نمایش پیام لغو
                             */

                            let cancelledTitle = 'سفارش لغو شده است';

                            if (
                                status ==
                                    @((int)OrderSellerStatus.لغو_شده_توسط_فروشنده)
                                ) {

                                cancelledTitle =
                                    'لغو شده توسط فروشنده';

                            }
                            else if (
                                status ==
                                    @((int)OrderSellerStatus.لغو_شده_توسط_ادمین)
                                ) {

                                cancelledTitle =
                                    'لغو شده توسط ادمین';

                            }
                            else if (
                                status ==
                                    @((int)OrderSellerStatus.لغو_شده_توسط_مشتری)
                                ) {

                                cancelledTitle =
                                    'لغو شده توسط مشتری';

                            }


                            /*
                             * ساخت پنل وضعیت لغو شده
                             */

                            const cancelledHtml = `

                                          

                                        <div class="oup-seller-status-cancelled-icon">

                                            <i class="fa-solid fa-ban"></i>

                                        </div>

                                        <div class="oup-seller-status-cancelled-content">

                                            <strong>
                                                ${cancelledTitle}
                                            </strong>

                                            <span>
                                                وضعیت این سفارش لغو شده است و امکان تغییر وضعیت آن وجود ندارد.
                                            </span>

                                        </div>

                         

            `;


                            $('#oup-seller-status-panel')
                                .html(cancelledHtml);


                            /*
                             * Success message
                             */

                            Swal.fire({

                                title: 'وضعیت تغییر کرد',

                                text:
                                    response.message ||
                                    'وضعیت سفارش با موفقیت تغییر کرد.',

                                icon: 'success',

                                timer: 1500,

                                showConfirmButton: false

                            });


                            return;
                        }


                        /*
                         * اگر وضعیت لغو نشده باشد،
                         * وضعیت قبلی همه دکمه‌ها را reset می‌کنیم.
                         */

                        allButtons
                            .removeClass(
                                'oup-seller-status-button-active'
                            )
                            .addClass(
                                'oup-seller-status-button-inactive'
                            );


                        /*
                         * دکمه انتخاب شده Active شود.
                         */

                        button
                            .removeClass(
                                'oup-seller-status-button-inactive'
                            )
                            .addClass(
                                'oup-seller-status-button-active'
                            );


                        /*
                         * Loading برداشته شود.
                         */

                        allButtons.removeClass(
                            'oup-seller-status-button-loading'
                        );


                        /*
                         * Success message
                         */

                        Swal.fire({

                            title: 'وضعیت تغییر کرد',

                            text:
                                response.message ||
                                'وضعیت سفارش با موفقیت تغییر کرد.',

                            icon: 'success',

                            timer: 1500,

                            showConfirmButton: false

                        });

                    },


                    /*
                     * Server Error
                     */

                    error: function () {

                        allButtons.removeClass(
                            'oup-seller-status-button-loading'
                        );


                        Swal.fire({

                            title: 'خطا',

                            text:
                                'در ارتباط با سرور مشکلی رخ داد.',

                            icon: 'error',

                            confirmButtonColor: '#fcb941'

                        });

                    }

                });

            });

        }
    );

    
</script>