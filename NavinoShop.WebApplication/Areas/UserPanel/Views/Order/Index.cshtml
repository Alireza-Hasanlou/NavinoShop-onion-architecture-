@using Query.Contract.UI.UserPanel.Order
@using Shared.Application
@{
    Layout = "_Layout";
    string ErrorMessage = ViewData["Error"] as string;
}
@model OrderUserPanelViewModel
<!-- مودال انتخاب آدرس -->
<partial name="_SelectOrderAddressPartial" />
<div class="modal fade" id="shippingModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-truck"></i> انتخاب روش ارسال
                </h5>
                <button type="button" class="close modal-close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="inv-shipping-box" id="invShippingBox_Unique_001">
                    <div class="inv-shipping-title">
                        <i class="fas fa-box"></i>
                        <span>روش‌های ارسال موجود</span>
                    </div>
                    <div class="inv-shipping-options">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary modal-close" data-dismiss="modal">
                    انصراف
                </button>
                <button type="button" class="btn btn-primary" id="confirmShippingBtn">
                    <i class="fas fa-check"></i> تایید و ثبت
                </button>
            </div>
        </div>
    </div>
</div>



<button class="btn-open-shipping">
    <i class="fas fa-truck"></i>
    <span id="shippingMethodBtn">انتخاب روش ارسال</span>
</button>

<section class="inv-section" id="invSection_Unique_001">
    <input type="hidden" id="orderId" value="@Model.OrderId" />
    <!-- ========== RIGHT SIDE: PRODUCTS ========== -->
    <div class="inv-products">

        <!-- header -->
        <div class="inv-header">
            <h2>
                <i class="fas fa-file-invoice"></i>
                پیش‌فاکتور پرداخت
            </h2>
            <div class="inv-badge">
                <i class="fas fa-hashtag"></i>
                سفارش #<span id="invOrderId_Unique_001">@Model.OrderId</span>
                <span style="margin:0 0.5rem;color:#b0c8e0;">|</span>
                <i class="far fa-clock"></i> پرداخت‌نشده
            </div>
        </div>
        <div class="container " style="border: 2px dashed #dce3ed; border-radius:10px">
            <div class="row">
                <div class="col-12 py-3">
                    <div class="pb-1 title">آدرس تحویل سفارش</div>
                    <div class="row">
                        <div class="col-12 col-md-9 pl-0" id="address-detail">
                            <div class="p-3 ml-3 mb-2 mb-md-0 ml-md-0 address-to-send">
                                <div class="address-title">
                                    <span id="province-title">@Model.Address.StateName</span>،
                                    <span id="city-title">@Model.Address.CityName</span>،
                                    <span id="address">@Model.Address.AddressDetail</span>،
                                </div>
                                <div class="col-12 col-md-4">شماره ملی: @Model.Address.NationalCode</div>
                                <div class="row">
                                    <div class="col-12 col-md-4">کدپستی: @Model.Address.PostalCode</div>

                                    <div class="col-12 col-md-8">تحویل گیرنده: @Model.Address.FullName | @Model.Address.Phone</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="row">
                                <div class="col-6 col-md-12 pl-2 px-md-3">
                                    <a id="openAddressModalBtn"><div class="btn btn-light w-100">تغییر آدرس</div></a>
                                </div>
                                <div class="col-6 col-md-12 pr-2 px-md-3">
                                    <a id="addNewAddressBtn2"><div class="btn btn-outline-dark mt-0 mt-md-1 w-100">افزودن آدرس جدید</div></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <!-- ========================================================= -->
        <!--  حلقه فروشندگان – بر اساس مدل OrderSellers                -->
        <!-- ========================================================= -->
        @if (Model.OrderSellers != null && Model.OrderSellers.Any())
        {
            var sellerIndex = 0;
            foreach (var seller in Model.OrderSellers)
            {
                sellerIndex++;
                var sellerBlockId = $"invSellerBlock_{sellerIndex}";
                var tableId = $"invItemsTable_{sellerIndex}";
                var sellerId = seller.SellerId;

                <div class="inv-seller-block" id="@sellerBlockId">
                    <div class="inv-seller-header">
                        <div class="inv-seller-name">
                            <i class="fas fa-store-alt"></i>
                            <span>فروشنده: @seller.SellerName</span>
                            <span class="inv-seller-code">
                                <i class="fas fa-tag"></i> کد: @sellerId
                            </span>
                        </div>
                        <div class="inv-seller-summary">
                            <span class="inv-label">جمع این فروشنده:</span>
                            <span class="inv-price-value" id="invSellerTotal_@sellerId">@seller.Price.ToString("N0") <span class="inv-currency">تومان</span></span>
                        </div>
                    </div>

                    <!-- جدول آیتم‌های این فروشنده -->
                    <div class="inv-table-wrap">
                        <table class="inv-items-table" id="@tableId">
                            <thead>
                                <tr>
                                    <th>محصول</th>
                                    <th>تعداد</th>
                                    <th>قیمت</th>
                                    <th>تخفیف</th>
                                    <th>قیمت پس از تخفیف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (seller.Items != null && seller.Items.Any())
                                {

                                    foreach (var item in seller.Items)
                                    {
                                        var discountPercent = 0;
                                        if (item.Price > 0 && item.PriceAfterOff > 0)
                                        {
                                            discountPercent = (int)Math.Round((1 - (decimal)item.PriceAfterOff / item.Price) * 100);
                                        }

                                        <tr>
                                            <td>
                                                <div class="inv-product-cell">
                                                    <div class="inv-product-img">
                                                        @if (!string.IsNullOrEmpty(item.ImageName))
                                                        {
                                                            <img src="@FileDirectories.ProductImageDirectory100@item.ImageName" alt="@item.ImageAlt" />
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-box"></i>
                                                        }
                                                    </div>
                                                    <span class="inv-product-name">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="inv-qty-badge">
                                                    <i class="fas fa-times"></i> @item.Quantity
                                                </span>
                                            </td>
                                            <td>
                                                <span class="inv-price-original" id="invPriceOrig_@seller.SellerId@item.ProductId">@item.Price.ToString("N0")</span>
                                            </td>
                                            <td>
                                                @if (discountPercent > 0)
                                                {
                                                    <span class="inv-discount-tag" id="invDiscountTag_@seller.SellerId@item.ProductId">@discountPercent%</span>
                                                }
                                                else
                                                {
                                                    <span class="inv-discount-tag inv-no-discount" id="invDiscountTag_@seller.SellerId@item.ProductId">--</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="inv-price-after" id="invPriceAfter_@seller.SellerId@item.ProductId">@item.PriceAfterOff.ToString("N0")</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="inv-empty-msg">
                                            <i class="fas fa-info-circle"></i> هیچ محصولی در این سفارش وجود ندارد.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- بخش تخفیف فروشنده -->
                    <!-- بخش تخفیف فروشنده -->
                    <div class="inv-seller-discount-row">
                        @if (seller.DiscountPercent < 1)
                        {
                            <div class="inv-discount-wrapper " id="invDiscountWrap_@sellerId">
                                <input type="text" placeholder="کد تخفیف فروشنده"
                                       id="invDiscountInput_@sellerId"
                                       class="inv-discount-input" />
                                <button id="invDiscountBtn_@sellerId"
                                        class="inv-discount-btn"
                                        onclick="invApplySellerDiscount('@sellerId')">
                                    <i class="fas fa-check"></i> اعمال
                                </button>
                            </div>
                        }
                        <div id="invDiscountDisplay_@sellerId" class="inv-discount-display">
                            @if (seller.DiscountPercent > 0)
                            {
                                <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                                    <span class="inv-discount-badge">
                                        <i class="fas fa-percent"></i> تخفیف: @seller.DiscountPercent%
                                        @if (!string.IsNullOrEmpty(seller.DiscountTitle))
                                        {
                                            <span>(کد: @seller.DiscountTitle)</span>
                                        }
                                    </span>
                                    <button id="invRemoveDiscountBtn_@sellerId"
                                            class="inv-remove-discount-btn"
                                            onclick="invRemoveSellerDiscount('@sellerId')">
                                        <i class="fas fa-times"></i> حذف تخفیف
                                    </button>
                                </div>
                            }
                        </div>

                        <span class="inv-payment-price">
                            <i class="fas fa-credit-card"></i>
                            مبلغ قابل‌پرداخت فروشنده:
                            <span id="invPaymentPrice_@sellerId">@String.Format("{0:N0}", seller.PaymentPrice)</span> تومان
                        </span>


                        <button id="invChoosePost" class="btn-open-shipping" onclick="openShippingModal('@seller.Id')">
                            <i class="fas fa-shipping-fast"></i>  انتخاب روش ارسال
                        </button>

                            <span class="text-secondary postMethod_@seller.Id"  >روش ارسال : @seller.PostTitle - @seller.PostPrice</span>
                    </div>

                </div>
            }
        }
        else
        {
            <div class="inv-empty-seller">
                <i class="fas fa-shopping-cart"></i>
                <p>هیچ فروشنده‌ای در این سفارش وجود ندارد.</p>
            </div>
        }
    </div>
    <!-- ========== END RIGHT SIDE ========== -->
    <!-- ========== LEFT SIDE: PAYMENT SUMMARY ========== -->
    <div class="inv-payment-side" id="invPaymentSide_Unique_001">

        <!-- discount section -->
        <div class="inv-discount-section" id="invDiscountSection_Unique_001">
            <div class="inv-discount-label">
                <i class="fas fa-gift"></i>
                <span>کد تخفیف</span>
                <span class="inv-discount-hint">(در صورت داشتن کد وارد کنید)</span>
            </div>

            @if (Model.DiscountPercent > 0)
            {
                <div class="inv-discount-applied" id="invDiscountApplied_Unique_001">
                    <span class="inv-discount-applied-icon">
                        <i class="fas fa-check-circle"></i>
                    </span>
                    <span class="inv-discount-applied-text">
                        تخفیف @Model.DiscountPercent% اعمال شد
                    </span>
                    @if (!string.IsNullOrEmpty(Model.DiscountTitle))
                    {
                        <span class="inv-discount-applied-code">(کد: @Model.DiscountTitle)</span>
                    }
                    <button id="invRemoveOrderDiscountBtn" class="inv-remove-discount-btn" onclick="invRemoveOrderDiscount()">
                        <i class="fas fa-times"></i> حذف تخفیف
                    </button>
                </div>
            }
            else
            {
                <div class="inv-discount-group" id="invDiscountGroup_Unique_001">
                    <input type="text" placeholder="مثلاً SUMMER1405" id="invDiscountInputGlobal_Unique_001" class="inv-discount-input" />
                    <button id="invDiscountBtnGlobal_Unique_001" class="inv-discount-btn">
                        <i class="fas fa-check-circle"></i> اعمال
                    </button>
                </div>
            }


        </div>


        <!-- باکس انتخاب روش پرداخت - سمت چپ -->
        <div class="inv-payment-method-box" id="invPaymentMethodBox_Unique_001">
            <div class="inv-payment-method-title">
                <i class="fas fa-credit-card"></i>
                <span>روش پرداخت</span>
            </div>
            <div class="inv-payment-method-options">
                <label class="inv-payment-method-option">
                    <input type="radio"
                           name="paymentMethod"
                           value="0"
                           checked
                           data-payment="پرداخت_از_درگاه" />
                    <div class="inv-payment-method-content">
                        <i class="fas fa-wallet"></i>
                        <div>
                            <span class="inv-payment-method-title-text">پرداخت از درگاه</span>
                            <span class="inv-payment-method-desc">پرداخت آنلاین از طریق درگاه بانکی</span>
                        </div>
                    </div>
                </label>
                <label class="inv-payment-method-option">
                    <input type="radio"
                           name="paymentMethod"
                           value="1"
                           data-payment="پرداخت_از_کیف_پول" />
                    <div class="inv-payment-method-content">
                        <i class="fas fa-piggy-bank"></i>
                        <div>
                            <span class="inv-payment-method-title-text">پرداخت از کیف پول</span>
                            <span class="inv-payment-method-desc">پرداخت با اعتبار کیف پول شما</span>
                        </div>
                    </div>
                </label>
            </div>
        </div>

        <!-- payment summary box -->
        <div class="inv-summary-box" id="invSummaryBox_Unique_001">
            <div class="inv-summary-title">
                <i class="fas fa-receipt"></i> خلاصه پرداخت
            </div>

            <div class="inv-payment-row">
                <span class="inv-label">جمع کل سفارش</span>
                <span class="inv-value" id="invOrderTotal_Unique_001">@Model.Price.ToString("N0") تومان</span>
            </div>

            <div class="inv-payment-row">
                <span class="inv-label">تخفیف کل</span>
                <span class="inv-value inv-discounted" id="invOrderDiscount_Unique_001">@Model.DiscountPrice.ToString("N0") تومان</span>
            </div>

            @if (Model.PostPrice > 0)
            {
                <div class="inv-payment-row">
                    <span class="inv-label"> مجموع هزینه ارسال </span>
                    <span class="inv-value inv-discounted" id="PostPrice">@Model.PostPrice.ToString("N0") تومان</span>
                </div>
            }

            <div class="inv-payment-row inv-total-payment">
                <span class="inv-label inv-bold">قابل پرداخت</span>
                <span class="inv-value inv-final-price" id="invFinalSummary_Unique_001">@Model.PaymentPrice.ToString("N0") تومان</span>
            </div>

            <button class="inv-pay-btn" id="invPayBtn_Unique_001">
                <i class="fas fa-lock"></i> پرداخت نهایی
            </button>
        </div>

        <div class="inv-footer">
            <span><i class="fas fa-shield-alt"></i> اطلاعات پرداخت شما محفوظ است</span>
            <span><i class="fas fa-credit-card"></i> پشتیبانی از تمام کارت‌های بانکی</span>
        </div>

    </div>
    <!-- ========== END LEFT SIDE ========== -->

</section>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <script>AlertSweetTimer("@ErrorMessage", "error", "Center");</script>
}
