@page
@using Shared.Domain.Enums
@model NavinoShop.WebApplication.Areas.Admin.Pages.IndexModel

@{
    Layout = "_AdminLayout";
    ViewData["title"] = "صفحه اصلی";
}




<link href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/min/moment.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/moment-jalaali@0.10.4/build/moment-jalaali.js"></script>

<script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/locale/fa.js"></script>


<section class="content">


    @await Component.InvokeAsync("SiteData")


    <!-- =====================================================
         Calendar + Support Messages
         ===================================================== -->

    <div class="row dashboard-top-row">


        <!-- =================================================
             پیام‌های پشتیبانی
             ================================================= -->

        <div class="col-md-6 support-wrapper">


            <div class="support-box">


                <!-- Header -->

                <div class="support-header">


                    <div class="support-header-info">


                        <div class="support-icon">

                            <i class="material-icons">
                                support_agent
                            </i>

                        </div>


                        <div class="support-title-wrapper">

                            <h3 class="support-title">
                                پیام‌های پشتیبانی
                            </h3>

                            <p class="support-subtitle">
                                آخرین درخواست‌های کاربران
                            </p>

                        </div>


                    </div>


                    <!-- تعداد پیام‌های جدید -->

                    <div class="support-count">
                        5
                    </div>


                </div>


                <!-- =================================================
                     Messages
                     ================================================= -->

                <div class="support-messages">

                    @foreach (var message in Model.Index.Messages)
                    {
                        <div class="support-message" id="message-@message.Id">


                            <div class="message-header">


                                <div class="message-user">


                                    <div class="message-avatar">
                                        <img src="@message.ImageName"
                                             style="width:30px; border-radius:50%" />
                                    </div>


                                    <div class="message-user-info">

                                        <span class="message-user-name">
                                            @message.FullName
                                        </span>

                                        <span class="message-time">
                                            @message.createdAt
                                        </span>

                                    </div>


                                </div>


                                <span class="message-status"></span>


                            </div>


                            <p class="message-text">
                                @message.Message

                            </p>


                            <div class="message-footer">


                                <span class="message-category">
                                    @message.Subject
                                </span>
                                @{
                                    var title = $"پاسخ به {message.FullName}";
                                    var inputLabel = "متن پاسخ";
                                    var placeholder = "پاسخ خود را بنویسید...";
                                    var smsText = "پاسخ با پیامک";
                                    var emailText = "پاسخ با ایمیل";
                                    var cancelText = "لغو";

                                    var smsUrl = "/Admin/UsersMessage/AnswerbySMS";
                                    var emailUrl = "/Admin/UsersMessage/AnswerbyEmail";

                                    var messageId = message.Id;
                                    var messageElementId = $"message-{messageId}";
                                }

                                <a onclick='showReplyAlert({
                                    title: "@title",
                                    inputLabel: "@inputLabel",
                                    placeholder: "@placeholder",
                                    smsText: "@smsText",
                                    emailText: "@emailText",
                                    cancelText: "@cancelText",
                                    smsUrl: "@smsUrl",
                                    emailUrl: "@emailUrl",
                                    messageElementId: "@messageElementId",
                                    data: {
                                    messageId: @messageId
                                    }
                                    });'
                                   class="reply-button">

                                    <i class="material-icons">
                                        reply
                                    </i>

                                    پاسخ

                                </a>

                            </div>


                        </div>

                    }

                  

           


                </div>


            </div>


        </div>


        <!-- =================================================
             تقویم
             ================================================= -->

        <div class="col-md-6 calendar-wrapper">

            <div class="calendar"></div>

        </div>


    </div>

    <div class="box box-info">
        <div class="box-header with-border">
            <h3 class="box-title">آخرین سفارشات</h3>

            <div class="box-tools pull-right">
                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                    <i class="fa fa-minus"></i>
                </button>
                <button type="button" class="btn btn-box-tool" data-widget="remove"><i class="fa fa-times"></i></button>
            </div>
        </div>
        <!-- /.box-header -->
        <div class="box-body">
            <div class="table-responsive">
                <table class="table no-margin">
                    <thead>
                        <tr>
                            <th>شماره</th>
                            <th>نام مشتری</th>
                            <th>وضعیت</th>
                            <th>تاریخ ایجاد</th>
                            <th>مبلغ</th>
                            <th>جزییات</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var order in Model.Index.LatestOrders)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td> @order.CustomerName</td>
                                <td>
                                    <span class="label
                                        @(order.Status == OrderStatus.ارسال_شده
                                            ? "label-success"
                                            : order.Status == OrderStatus.پرداخت_نشده
                                                ? "label-warning"
                                                : order.Status == OrderStatus.پرداخت_شده
                                                    ? "label-danger"
                                                    : order.Status == OrderStatus.ارسال_شده
                                                        ? "label-info"
                                                        : "label-default")">
                                        @order.Status.ToString().Replace("_", " ")
                                    </span>
                                </td>
                                <td>@order.CreateAt</td>
                                <td>@order.Price تومان</td>
                                <td>
                                    <a href="/Admin/Orders/OrderDetails/@order.OrderId" class="btn">

                                        <i class="fa-sharp-duotone fa-solid fa-info" style="--fa-primary-color: rgb(30, 48, 80); --fa-secondary-color: rgb(30, 48, 80);"></i>
                                    </a>
                                </td>
                            </tr>
                        }

                       
                    </tbody>
                </table>
            </div>
            <!-- /.table-responsive -->
        </div>
        <!-- /.box-body -->
        <div class="box-footer clearfix">
            <a href="/Admin/Orders" class="btn btn-sm btn-default btn-flat pull-right">نمایش همه</a>
        </div>
        <!-- /.box-footer -->
    </div>
    <!-- =====================================================
         Charts
         ===================================================== -->

    <div class="dashboard-charts">


        <!-- =====================================================
             فروش ماهانه
             ===================================================== -->

        <div class="dashboard-chart-card">


            <div class="dashboard-chart-header">


                <div>

                    <h3 class="dashboard-chart-title">
                        فروش ماهانه
                    </h3>


                    <div class="dashboard-chart-subtitle">
                        میزان فروش در ۱۲ ماه اخیر
                    </div>

                </div>


            </div>


            <div class="dashboard-chart monthly-chart">

                <div id="monthlySalesChart"></div>

            </div>


        </div>


        <!-- =====================================================
             فروش هفتگی
             ===================================================== -->

        <div class="row weekly-chart-row">


     

            <div class="col-lg-12 col-md-12">


                <div class="dashboard-chart-card">


                    <div class="dashboard-chart-header">


                        <div>

                            <h3 class="dashboard-chart-title">
                                فروش هفتگی
                            </h3>


                            <div class="dashboard-chart-subtitle">
                                تعداد محصولات فروخته شده در روزهای هفته جاری
                            </div>

                        </div>


                    </div>


                    <div class="dashboard-chart weekly-chart">

                        <div id="weeklySalesChart"></div>

                    </div>


                </div>


            </div>


        </div>


    </div>
    
   
</section>


@section Scripts {


    <script>


        /* =========================================================
           Calendar
           ========================================================= */


        const monthTemplate = () => `

                                                    <div class="days-title">

                                                        <div>ش</div>
                                                        <div>ی</div>
                                                        <div>د</div>
                                                        <div>س</div>
                                                        <div>چ</div>
                                                        <div>پ</div>
                                                        <div>ج</div>

                                                    </div>


                                                    <div class="days"></div>

                                                `;


        const dpTemplate = () => `

                                                    <div class="date-picker">


                                                        <div class="head">


                                                            <button type="button">

                                                                <i class="material-icons">
                                                                    chevron_right
                                                                </i>

                                                            </button>


                                                            <div class="title">

                                                                <h4></h4>

                                                                <div></div>

                                                            </div>


                                                            <button type="button">

                                                                <i class="material-icons">
                                                                    chevron_left
                                                                </i>

                                                            </button>


                                                        </div>


                                                        <div class="month"></div>


                                                    </div>

                                                `;


        const calendar =
            document.querySelector('.calendar');


        if (calendar) {


            calendar.innerHTML =
                dpTemplate();


            moment.locale('fa');


            const today =
                moment();


            const currentMonth =
                moment(
                    today.format('jYYYY/jMM/01'),
                    'jYYYY/jMM/jDD'
                );


            const vMonth =
                calendar.querySelector('.month');


            const vTitle =
                calendar.querySelector(
                    '.head .title h4'
                );


            const vTitleEn =
                calendar.querySelector(
                    '.head .title div'
                );


            const manageMonth =
                (navigate = '') => {


                    if (navigate === 'next') {

                        currentMonth.add(
                            1,
                            'jMonth'
                        );

                    }
                    else if (navigate === 'prev') {

                        currentMonth.subtract(
                            1,
                            'jMonth'
                        );

                    }


                    const month =
                        document.createElement('div');


                    month.innerHTML =
                        monthTemplate();


                    const firstDay =
                        moment(
                            currentMonth.format(
                                'jYYYY/jMM/01'
                            ),
                            'jYYYY/jMM/jDD'
                        );


                    const daysInMonth =
                        firstDay.jDaysInMonth();


                    const lastDay =
                        firstDay
                            .clone()
                            .add(
                                daysInMonth - 1,
                                'days'
                            );


                    vTitle.textContent =
                        firstDay.format(
                            'jMMMM jYYYY'
                        );


                    vTitleEn.textContent =
                        firstDay
                            .clone()
                            .locale('en')
                            .format(
                                'MMMM YYYY'
                            );


                    const vDays =
                        month.querySelector(
                            '.days'
                        );


                    const addDay =
                        (
                            date,
                            disabled = false
                        ) => {


                            const vDay =
                                document.createElement(
                                    'div'
                                );


                            const vDayEn =
                                document.createElement(
                                    'div'
                                );


                            vDay.textContent =
                                date.format('jD');


                            const isToday =
                                date.format(
                                    'jYYYY/jMM/jDD'
                                ) ===
                                today.format(
                                    'jYYYY/jMM/jDD'
                                );


                            vDay.className =
                                `${isToday ? 'today' : ''} ` +
                                `${disabled ? 'disable' : ''}`;


                            vDayEn.textContent =
                                date
                                    .clone()
                                    .locale('en')
                                    .format('D');


                            vDay.appendChild(
                                vDayEn
                            );


                            vDays.appendChild(
                                vDay
                            );

                        };


                    const firstDayOfWeek =
                        (firstDay.day() + 1) % 7;


                    for (
                        let i =
                            firstDayOfWeek - 1;

                        i >= 0;

                        i--
                    ) {


                        const date =
                            firstDay
                                .clone()
                                .subtract(
                                    i + 1,
                                    'days'
                                );


                        addDay(
                            date,
                            true
                        );

                    }


                    for (
                        let i = 0;

                        i < daysInMonth;

                        i++
                    ) {


                        const date =
                            firstDay
                                .clone()
                                .add(
                                    i,
                                    'days'
                                );


                        addDay(date);

                    }


                    const lastDayOfWeek =
                        (lastDay.day() + 1) % 7;


                    const remaining =
                        6 - lastDayOfWeek;


                    for (
                        let i = 1;

                        i <= remaining;

                        i++
                    ) {


                        const date =
                            lastDay
                                .clone()
                                .add(
                                    i,
                                    'days'
                                );


                        addDay(
                            date,
                            true
                        );

                    }


                    if (navigate === 'next') {


                        if (vMonth.children[0]) {

                            vMonth.children[0]
                                .classList
                                .add('right');

                        }


                        month.classList.add(
                            'left'
                        );

                    }


                    if (navigate === 'prev') {


                        if (vMonth.children[0]) {

                            vMonth.children[0]
                                .classList
                                .add('left');

                        }


                        month.classList.add(
                            'right'
                        );

                    }


                    vMonth.appendChild(
                        month
                    );


                    setTimeout(() => {

                        month.className = '';

                        vMonth.style.height =
                            `${month.clientHeight}px`;

                    }, 20);


                    if (navigate !== '') {


                        setTimeout(() => {

                            if (vMonth.children[0]) {

                                vMonth.children[0]
                                    .remove();

                            }

                        }, 500);

                    }

                };


            manageMonth();


            const buttons =
                calendar.querySelectorAll(
                    '.head button'
                );


            buttons[0].addEventListener(
                'click',
                () => manageMonth('prev')
            );


            buttons[1].addEventListener(
                'click',
                () => manageMonth('next')
            );

        }


        /* =========================================================
           Support Messages State
           ========================================================= */

        function updateSupportMessagesState() {

            const messageContainer =
                document.querySelector(
                    '.support-messages'
                );

            const supportCount =
                document.querySelector(
                    '.support-count'
                );


            if (!messageContainer) {
                return;
            }


            const messages =
                messageContainer.querySelectorAll(
                    '.support-message'
                );


            /*
             * بروزرسانی تعداد پیام‌ها
             */
            if (supportCount) {

                supportCount.textContent =
                    messages.length;

            }


            /*
             * حذف Empty State قبلی
             */
            const oldEmptyState =
                messageContainer.querySelector(
                    '.support-empty'
                );


            if (oldEmptyState) {

                oldEmptyState.remove();

            }


            /*
             * اگر هیچ پیامی وجود نداشت
             */
            if (messages.length === 0) {


                const emptyState =
                    document.createElement('div');


                emptyState.className =
                    'support-empty';


                emptyState.innerHTML = `

                                                            <div class="support-empty-icon">

                                                                <i class="material-icons">
                                                                    mark_email_unread
                                                                </i>

                                                            </div>


                                                            <p class="support-empty-title">
                                                                پیامی وجود ندارد
                                                            </p>


                                                            <p class="support-empty-text">
                                                                در حال حاضر درخواست جدیدی
                                                                از سمت کاربران ثبت نشده است.
                                                            </p>

                                                        `;


                messageContainer.appendChild(
                    emptyState
                );

            }

        }


        /* =========================================================
           Sync Support Box Height With Calendar
           ========================================================= */

        function syncSupportBoxHeight() {


            const calendarWrapper =
                document.querySelector(
                    '.calendar-wrapper'
                );


            const supportBox =
                document.querySelector(
                    '.support-box'
                );


            if (
                !calendarWrapper ||
                !supportBox
            ) {

                return;

            }


            if (
                window.innerWidth <= 991
            ) {

                supportBox.style.height =
                    '';

                return;

            }


            const height =
                calendarWrapper.offsetHeight;


            if (height > 0) {

                supportBox.style.height =
                    `${height}px`;

            }

        }


        /* =========================================================
           Initialize
           ========================================================= */

        updateSupportMessagesState();


        window.addEventListener(
            'load',
            function () {


                updateSupportMessagesState();


                syncSupportBoxHeight();


                setTimeout(
                    syncSupportBoxHeight,
                    200
                );


            }
        );


        window.addEventListener(
            'resize',
            function () {

                syncSupportBoxHeight();

            }
        );


        setTimeout(
            syncSupportBoxHeight,
            300
        );


    </script>

}